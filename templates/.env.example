# Agymes Environment Configuration
# Copy to ~/.agymes/.env (or run `agymes setup`)

# Required for Telegram Gateway: get from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to use the bot
# (leave empty to use /pair flow on first launch)
TELEGRAM_ALLOWED_USERS=

# Optional overrides
# AGY_BIN=~/.local/bin/agy
# AGY_WORKDIR=~
# AGY_MODE=auto
# AGY_TIMEOUT_SECONDS=600
